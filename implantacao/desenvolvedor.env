# Dados PÚBLICOS do desenvolvedor do Pressente Ponto (nada secreto aqui).
# Edite, faça commit e rode «Publicar o Pressente Ponto → 3»: o servidor passa a usar.
# Eles vão no AFD (registro 1), no AEJ (registro 08), no comprovante e no atestado técnico.
# Certificado, senhas e chaves NUNCA entram neste arquivo.

# Número do registro do REP-P no INPI (só os dígitos), quando sair o certificado.
PONTO_NUMERO_INPI=

# Quem desenvolve: 1 = CNPJ, 2 = CPF.
PONTO_DESENVOLVEDOR_TIPO=1
PONTO_DESENVOLVEDOR_ID=
PONTO_DESENVOLVEDOR_RAZAO=
PONTO_DESENVOLVEDOR_EMAIL=

# Quem assina o atestado técnico (cada um com o próprio e-CPF).
PONTO_REPRESENTANTE_LEGAL=
PONTO_RESPONSAVEL_TECNICO=
